# Local-only values. Do not reuse these values outside this compose preview.
POSTGRES_DB=schemasprint
POSTGRES_USER=schemasprint
POSTGRES_PASSWORD=schemasprint_local_only
SCHEMASPRINT_SESSION_PEPPER=local_only_session_pepper_please_replace_1234567890
SCHEMASPRINT_CSRF_KEY=local_only_csrf_key_please_replace_1234567890
SCHEMASPRINT_ALLOWED_ORIGIN=http://localhost:8080
# Optional Jev assessment. Keep unavailable/stub until an approved endpoint and key exist.
SCHEMASPRINT_JEV_MODE=unavailable
SCHEMASPRINT_JEV_BASE_URL=
SCHEMASPRINT_JEV_API_KEY=
SCHEMASPRINT_JEV_MODEL=jev-latest
SCHEMASPRINT_JEV_TIMEOUT_SECONDS=10
SCHEMASPRINT_JEV_MAX_RETRIES=2
# Optional server-side LLM generation. Leave the key empty until Groq is approved.
SCHEMASPRINT_LLM_MODE=unavailable
SCHEMASPRINT_GROQ_API_URL=https://api.groq.com/openai/v1
SCHEMASPRINT_GROQ_API_KEY=
SCHEMASPRINT_GROQ_MODEL=openai/gpt-oss-20b
SCHEMASPRINT_GROQ_TIMEOUT_SECONDS=20
