# Local-only values. Do not reuse these values outside this compose preview.
POSTGRES_DB=schemasprint
POSTGRES_USER=schemasprint
POSTGRES_PASSWORD=local_only
SESSION_PEPPER=local_only_session_pepper_please_replace_1234567890
CSRF_KEY=local_only_csrf_key_please_replace_1234567890
ALLOWED_ORIGIN=http://localhost:8080
# Optional Jev assessment. Keep unavailable/stub until an approved endpoint and key exist.
JEV_MODE=unavailable
JEV_BASE_URL=https://api.typesafe.ai
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=10
JEV_MAX_RETRIES=2
# Optional server-side LLM generation. Leave the key empty until Groq is approved.
LLM_MODE=unavailable
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=20
